# Copy this file to .env and fill with your credentials (DO NOT commit secrets)

# Payment Provider (pagbank | abacatepay)
PAYMENT_PROVIDER=pagbank

# === PagBank (default) ===
PAGBANK_TOKEN=your_pagbank_token
PAGBANK_API_URL=https://sandbox.api.pagseguro.com/
PAGBANK_WEBHOOK_URL=https://your-domain.com/api/payments/webhook
PAGBANK_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
PAGBANK_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# === AbacatePay (alternative) ===
ABACATEPAY_API_KEY=your_abacatepay_api_key
ABACATEPAY_WEBHOOK_SECRET=your_webhook_secret

# === Mercado Pago (alternative) ===
MERCADOPAGO_ACCESS_TOKEN=your_mercado_pago_access_token
MERCADOPAGO_WEBHOOK_SECRET=your_webhook_secret
MERCADOPAGO_ENVIRONMENT=production
NEXT_PUBLIC_MERCADOPAGO_ENVIRONMENT=production

# === Mercado Pago OAuth / Marketplace (for seller split payments) ===
MERCADOPAGO_CLIENT_ID=your_app_id
MERCADOPAGO_CLIENT_SECRET=your_client_secret
MERCADOPAGO_REDIRECT_URI=https://your-domain.com/api/mercadopago/oauth/callback

# Cloudinary (required for image upload)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=nexorder

# Firebase Admin (if used server-side in apps)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL="your_client_email"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Firebase Client (public - must use NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id
