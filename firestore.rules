rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(companyId) {
      return isAuth()
        && ((request.auth.token.role == "owner" || request.auth.token.role == "admin")
          || (companyId != null
            && companyId != "default"
            && exists(/databases/$(database)/documents/companies/$(companyId))
            && get(/databases/$(database)/documents/companies/$(companyId)).data.ownerId == request.auth.uid));
    }

    function isStoreAdmin(companyId) {
      return isOwner(companyId)
        || (isAuth()
            && companyId != null
            && companyId != "default"
            && exists(/databases/$(database)/documents/companies/$(companyId))
            && get(/databases/$(database)/documents/companies/$(companyId)).data.adminIds != null
            && request.auth.uid in get(/databases/$(database)/documents/companies/$(companyId)).data.adminIds);
    }

    // =============================================
    // COLEÇÕES PÚBLICAS (leitura pública, escrita autenticada)
    // =============================================

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAuth();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAuth();
    }

    match /condiments/{condimentId} {
      allow read: if true;
      allow write: if isAuth();
    }

    match /flavors/{flavorId} {
      allow read: if true;
      allow write: if isAuth();
    }

    match /neighborhoods/{neighborhoodId} {
      allow read: if true;
      allow write: if isAuth();
    }

    match /cities/{cityId} {
      allow read: if true;
      allow write: if isAuth();
    }

    match /orders/{orderId} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isAuth();
    }

    match /deliveryCosts/{costId} {
      allow read: if true;
      allow write: if isAuth();
    }

    match /storeCitySettings/{settingId} {
      allow read: if true;
      allow write: if isAuth();
    }

    // =============================================
    // ENDEREÇOS DO CLIENTE
    // =============================================

    match /addresses/{addressId} {
      allow read, delete: if isAuth() && request.auth.uid == resource.data.userId;
      allow create: if isAuth() && request.auth.uid == request.resource.data.userId;
      allow update: if isAuth()
        && request.auth.uid == resource.data.userId
        && request.auth.uid == request.resource.data.userId;
    }

    // =============================================
    // EMPRESAS / LOJAS
    // =============================================

    match /companies/{companyId} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isAuth() && (
        isOwner(companyId)
        || (resource.data.adminIds != null && request.auth.uid in resource.data.adminIds)
        || (resource.data.ownerId == null && resource.data.adminIds == null)
      );
    }

    // =============================================
    // USUÁRIOS
    // =============================================

    match /users/{userId} {
      allow read: if isAuth();
      allow write: if isAuth() && (
        request.auth.uid == userId
        || (resource != null && resource.data.companyId != null && isStoreAdmin(resource.data.companyId))
        || (request.resource.data.companyId != null && isStoreAdmin(request.resource.data.companyId))
      );
    }

    // =============================================
    // NOTIFICAÇÕES
    // =============================================

    match /notifications/{notificationId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && request.auth.uid == resource.data.userId;
      allow delete: if false;
    }

    match /push_tokens/{tokenId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && request.auth.uid == resource.data.uid;
      allow delete: if isAuth() && request.auth.uid == resource.data.uid;
    }

    // =============================================
    // AVALIAÇÕES
    // =============================================

    match /order_reviews/{reviewId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if false;
    }

    // =============================================
    // EVENTOS PROMOCIONAIS
    // =============================================

    match /promotionEvents/{eventId} {
      allow read: if true;
      allow write: if isAuth();
    }

    // =============================================
    // PROMOÇÕES
    // =============================================

    match /promotions/{promotionId} {
      allow read: if true;
      allow write: if isAuth();
    }

    // =============================================
    // AUDITORIA DE COMISSÃO
    // =============================================

    match /commission_audit_log/{logId} {
      allow read: if isOwner(resource.data.companyId);
      allow create: if isAuth();
      allow update, delete: if false;
    }

    // =============================================
    // CUPONS DE DESCONTO
    // =============================================

    match /coupons/{couponId} {
      allow read: if isAuth();
      allow create: if isAuth() && isStoreAdmin(request.resource.data.storeId);
      allow update, delete: if isAuth()
        && resource.data.storeId != null
        && isStoreAdmin(resource.data.storeId);
    }

    // =============================================
    // USO DE CUPONS (apenas server-side via Admin SDK)
    // =============================================

    match /coupon_usage/{usageId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // =============================================
    // CONTATOS / MENSAGENS
    // =============================================

    match /contacts/{contactId} {
      allow read: if isAuth();
      allow create: if true;
      allow update: if isAuth() && (request.auth.token.role == "owner" || request.auth.token.role == "admin");
      allow delete: if isAuth() && (request.auth.token.role == "owner" || request.auth.token.role == "admin");
    }

    // =============================================
    // CONFIGURAÇÕES GLOBAIS (apenas owner/admin)
    // =============================================

    match /settings/{settingId} {
      allow read: if isAuth();
      allow write: if isAuth() && (request.auth.token.role == "owner" || request.auth.token.role == "admin");
    }

    // =============================================
    // GRUPOS OBRIGATÓRIOS DO PRODUTO
    // - Leitura: pública (totem)
    // - Escrita: autenticado
    // =============================================

    match /requiredGroups/{groupId} {
      allow read: if true;
      allow write: if isAuth();
    }

    match /requiredItems/{itemId} {
      allow read: if true;
      allow write: if isAuth();
    }

    // =============================================
    // ESTADOS OAUTH MERCADO PAGO (server-side via Admin SDK)
    // =============================================

    match /mercadopago_oauth_states/{stateId} {
      allow read, write: if false;
    }
  }
}
